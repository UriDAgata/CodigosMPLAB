#include "p16f887.inc"

; CONFIGURATION BITS
__CONFIG _CONFIG1, _CP_OFF & _WDT_OFF & _PWRTE_ON & _INTOSC & _LVP_OFF
__CONFIG _CONFIG2, _BOR21V

; VARIABLES
CBLOCK 0x20
    d1
    d2
    d3
    TEMP_W
    TEMP_STATUS
ENDC

; SETEO DE PUERTOS
ORG 0x00
GOTO START

; INTERRUPCION
ORG 0x04
RETFIE

START:
    ; CONFIGURAR PUERTOS
    BANKSEL ANSEL
    CLRF ANSEL
    CLRF ANSELH
    
    BANKSEL TRISC
    CLRF TRISC          ; PORTC COMO SALIDA
    BANKSEL TRISB
    MOVLW B'00010000'   ; RB4 ENTRADA, RB3 SALIDA
    MOVWF TRISB
    
    BANKSEL PORTC
    CLRF PORTC
    CLRF PORTB
    
    ; INICIALIZAR LCD
    CALL LCD_INIT
    CALL DELAY_100MS
    
    ; MOSTRAR MENSAJE INICIAL
    CALL CLEAR_LCD
    MOVLW 'H'
    CALL LCD_CHAR
    MOVLW 'O'
    CALL LCD_CHAR
    MOVLW 'L'
    CALL LCD_CHAR
    MOVLW 'A'
    CALL LCD_CHAR
    MOVLW ' '
    CALL LCD_CHAR
    MOVLW 'M'
    CALL LCD_CHAR
    MOVLW 'U'
    CALL LCD_CHAR
    MOVLW 'N'
    CALL LCD_CHAR
    MOVLW 'D'
    CALL LCD_CHAR
    MOVLW 'O'
    CALL LCD_CHAR
    MOVLW '!'
    CALL LCD_CHAR

MAIN_LOOP:
    GOTO MAIN_LOOP

; ========== RUTINAS LCD ==========
LCD_INIT:
    CALL DELAY_100MS     ; ESPERAR INICIALIZACIÓN
    
    ; SECUENCIA DE INICIALIZACIÓN
    BCF PORTC,0          ; RS = 0 (COMANDOS)
    
    MOVLW 0x30
    MOVWF PORTC
    CALL PULSO_E
    CALL DELAY_100MS
    
    MOVLW 0x30
    MOVWF PORTC
    CALL PULSO_E
    CALL DELAY_10MS
    
    MOVLW 0x30
    MOVWF PORTC
    CALL PULSO_E
    CALL DELAY_10MS
    
    ; MODO 8 BITS, 2 LÍNEAS
    MOVLW 0x38
    MOVWF PORTC
    CALL PULSO_E
    CALL DELAY_10MS
    
    ; DISPLAY ON, CURSOR OFF
    MOVLW 0x0C
    MOVWF PORTC
    CALL PULSO_E
    CALL DELAY_10MS
    
    ; CLEAR DISPLAY
    MOVLW 0x01
    MOVWF PORTC
    CALL PULSO_E
    CALL DELAY_10MS
    
    ; ENTRY MODE SET
    MOVLW 0x06
    MOVWF PORTC
    CALL PULSO_E
    CALL DELAY_10MS
    
    RETURN

PULSO_E:
    BSF PORTC,1          ; E = 1
    CALL DELAY_1MS
    BCF PORTC,1          ; E = 0
    CALL DELAY_1MS
    RETURN

LCD_CMD:
    MOVWF PORTC
    BCF PORTC,0          ; RS = 0 (COMANDO)
    CALL PULSO_E
    CALL DELAY_1MS
    RETURN

LCD_CHAR:
    MOVWF PORTC
    BSF PORTC,0          ; RS = 1 (DATO)
    CALL PULSO_E
    CALL DELAY_1MS
    RETURN

CLEAR_LCD:
    MOVLW 0x01
    CALL LCD_CMD
    CALL DELAY_10MS
    RETURN

; ========== RUTINAS DE DELAY ==========
DELAY_1MS:
    MOVLW 0x02
    MOVWF d1
DELAY_1MS_LOOP:
    MOVLW 0xF9
    MOVWF d2
DELAY_1MS_LOOP2:
    DECFSZ d2, F
    GOTO DELAY_1MS_LOOP2
    DECFSZ d1, F
    GOTO DELAY_1MS_LOOP
    RETURN

DELAY_10MS:
    MOVLW 0x0A
    MOVWF d3
DELAY_10MS_LOOP:
    CALL DELAY_1MS
    DECFSZ d3, F
    GOTO DELAY_10MS_LOOP
    RETURN

DELAY_100MS:
    MOVLW 0x64
    MOVWF d3
DELAY_100MS_LOOP:
    CALL DELAY_1MS
    DECFSZ d3, F
    GOTO DELAY_100MS_LOOP
    RETURN

END
